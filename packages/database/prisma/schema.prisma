  bomCode             String                             @db.VarChar(100)
  bomVersion          Int
  sourceUnitCost      Decimal                            @default(0) @db.Decimal(18, 4)
  sourceTotalValue    Decimal                            @default(0) @db.Decimal(18, 2)
  lossValue           Decimal                            @default(0) @db.Decimal(18, 2)
  status              String                             @default("DRAFT") @db.VarChar(30)
