  updatedAt         String?           @db.Text
  productpackagings productpackagings @relation(fields: [packagingId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "inventory_balances_ibfk_1")
  warehouses        warehouses        @relation(fields: [warehouseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "inventory_balances_ibfk_2")

  @@unique([packagingId, warehouseId], map: "packagingId")
  @@index([warehouseId], map: "warehouseId")
}

model product_categories {
  id                       Int                  @id @default(autoincrement())
  name                     String               @unique(map: "name") @db.VarChar(100)
  description              String?              @db.Text
  parentId                 Int?
  product_categories       product_categories?  @relation("product_categoriesToproduct_categories", fields: [parentId], references: [id], onUpdate: Restrict, map: "product_categories_ibfk_1")
  other_product_categories product_categories[] @relation("product_categoriesToproduct_categories")

  @@index([parentId], map: "parentId")
}

model schema_migrations {
  id         String   @id @db.VarChar(100)
  applied_at DateTime @default(now())
}

model system_settings {
  id          Int     @id @default(autoincrement())
  key         String  @unique(map: "key") @db.VarChar(100)
  value       String? @db.Text
  description String? @db.Text
  updatedAt   String? @db.Text
}

model unit_conversions {
  id                                       Int   @id @default(autoincrement())
  fromUnitId                               Int
  toUnitId                                 Int
  ratio                                    Float
  units_unit_conversions_fromUnitIdTounits units @relation("unit_conversions_fromUnitIdTounits", fields: [fromUnitId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "unit_conversions_ibfk_1")
  units_unit_conversions_toUnitIdTounits   units @relation("unit_conversions_toUnitIdTounits", fields: [toUnitId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "unit_conversions_ibfk_2")

  @@unique([fromUnitId, toUnitId], map: "fromUnitId")
  @@index([toUnitId], map: "toUnitId")
}

model units {
  id                                                  Int                @id @default(autoincrement())
  name                                                String             @unique(map: "name") @db.VarChar(50)
  symbol                                              String?            @db.VarChar(20)
  description                                         String?            @db.Text
  unit_conversions_unit_conversions_fromUnitIdTounits unit_conversions[] @relation("unit_conversions_fromUnitIdTounits")
  unit_conversions_unit_conversions_toUnitIdTounits   unit_conversions[] @relation("unit_conversions_toUnitIdTounits")
}

model warehouse_zones {
  id          Int        @id @default(autoincrement())
  warehouseId Int
  name        String     @db.VarChar(100)
  description String?    @db.Text
  isActive    Int?       @default(1)
  warehouses  warehouses @relation(fields: [warehouseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "warehouse_zones_ibfk_1")

  @@index([warehouseId], map: "warehouseId")
}

// ── Bán hàng online (gộp từ dự án SPX) ─────────────────────────────
model online_products {
  id          Int      @id @default(autoincrement())
  packagingId Int?
  name        String   @db.VarChar(255)
  price       Decimal  @default(0) @db.Decimal(10, 2)
  unit        String?  @default("Cái") @db.VarChar(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productpackagings productpackagings? @relation(fields: [packagingId], references: [id], onUpdate: Restrict, map: "online_product_packaging_fk")

  @@index([packagingId], map: "online_product_packaging_idx")
}

model online_orders {
  id             Int      @id @default(autoincrement())
  orderCode      String   @unique(map: "orderCode") @db.VarChar(50)
  orderDate      DateTime @default(now())
  recipientName  String   @db.VarChar(100)
  phone          String   @db.VarChar(20)
  address        String   @db.VarChar(255)
  shippingFee    Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(10, 2)
  status         String   @default("Pending") @db.VarChar(20)
  trackingNumber String?  @db.VarChar(100)
  trackingSyncedAt DateTime?
  createdBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          online_order_items[]

  @@index([status], map: "online_order_status_idx")
}

model online_order_items {
  id            Int      @id @default(autoincrement())
  orderId       Int
  packagingId   Int?
  productName   String   @db.VarChar(255)
  quantity      Int      @default(1)
  price         Decimal  @default(0) @db.Decimal(10, 2)
  unit          String?  @default("Cái") @db.VarChar(50)
  online_orders online_orders @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "online_item_order_fk")

  @@index([orderId], map: "online_item_order_idx")
}
