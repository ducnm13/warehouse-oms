  plannedQuantity      Decimal                         @db.Decimal(18, 4)
  actualQuantity       Decimal                         @default(0) @db.Decimal(18, 4)
  componentWarehouseId Int
  outputWarehouseId    Int
  bomId                Int
  bomCode              String                          @db.VarChar(100)
  bomVersion           Int
  assemblyCost         Decimal                         @default(0) @db.Decimal(18, 2)
  outputUnitCost       Decimal                         @default(0) @db.Decimal(18, 4)
  outputTotalValue     Decimal                         @default(0) @db.Decimal(18, 2)
  status               String                          @default("DRAFT") @db.VarChar(30)
  note                 String?                         @db.VarChar(500)
  version              Int                             @default(1)
  sourceModule         String                          @default("ASSEMBLY_V1") @db.VarChar(50)
  createdBy            Int
  createdAt            DateTime                        @default(now()) @db.DateTime(3)
  updatedAt            DateTime                        @db.DateTime(3)
  postedAt             DateTime?                       @db.DateTime(3)
