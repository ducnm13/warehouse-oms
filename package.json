{
	"name": "challenge-erp",
	"private": true,
	"version": "0.1.1",
	"type": "module",
	"main": "server.js",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"code": "tsx server.ts",
		"preview": "vite preview",
		"clean": "rm -rf dist",
		"lint": "tsc --noEmit",
		"dev": "vite --host",
		"build": "tsc && vite build",
		"server": "tsx server.ts",
		"typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
		"prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
		"prisma:push": "prisma db push --schema packages/database/prisma/schema.prisma",
		"prisma:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
		"db:reset-operational": "tsx scripts/reset-operational-data.ts"
	},
	"dependencies": {
		"@google/genai": "^1.29.0",
		"@hookform/resolvers": "^5.2.1",
		"@tailwindcss/vite": "^4.1.14",
		"@tanstack/react-query": "^5.102.6",
		"@vitejs/plugin-react": "^5.0.4",
		"axios": "^1.18.1",
		"bcryptjs": "^3.0.3",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"dotenv": "^17.4.2",
		"exceljs": "^4.4.0",
		"express": "^4.21.2",
		"file-saver": "^2.0.5",
		"jsonwebtoken": "^9.0.3",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.7",
		"lucide-react": "^0.546.0",
		"motion": "^12.23.24",
		"mysql2": "^3.22.3",
		"react": "^19.0.1",
		"react-datepicker": "^9.1.0",
		"react-dom": "^19.0.1",
		"react-hook-form": "^7.62.0",
		"react-hot-toast": "^2.6.0",
		"react-router-dom": "^7.18.2",
		"react-to-print": "^3.3.0",
		"recharts": "^3.8.1",
		"sqlite": "^5.1.1",
		"sqlite3": "^6.0.1",
		"tailwind-merge": "^3.5.0",
		"vite": "^6.2.3"
	},
	"devDependencies": {
		"@esbuild-plugins/node-globals-polyfill": "^0.2.3",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.14.0",
		"@types/react-datepicker": "^6.2.0",
		"autoprefixer": "^10.4.21",
		"concurrently": "^9.2.1",
		"rollup-plugin-polyfill-node": "^0.13.0",
		"tailwindcss": "^4.1.14",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typescript": "~5.8.2",
		"vite": "^6.2.3",
		"vite-plugin-node-polyfills": "^0.28.0",
		"wait-on": "^9.0.5"
	},
	"allowScripts": {
		"prisma@6.19.2": true,
		"@prisma/client@6.19.2": true,
		"@prisma/engines@6.19.2": true
	}
}
