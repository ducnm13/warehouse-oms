NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

HOST=localhost
DB_USER=erp_user
DB_PASS=replace-me
DB_NAME=warehouse_oms_v2
DATABASE_URL=mysql://erp_user:replace-me@localhost:3306/warehouse_oms_v2

CORS_ORIGIN=http://localhost:5173

# Menu Developer (chỉ tài khoản có quyền system.admin). Đặt "false" để tắt hoàn toàn.
DEV_TOOLS_ENABLED=true
# Danh sách username được phép dùng Dev Tools (phân tách bằng dấu phẩy)
DEV_TOOLS_USERS=ducnm,admin


mysql -u erp_user -p warehouse_oms_v2 < warehouse_oms_v2.sql


sudo mysql DROP DATABASE warehouse_oms_v2;

sudo mysql -e "CREATE DATABASE warehouse_oms_v2 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
sudo mysql -e "CREATE USER 'erp_user2'@'localhost' IDENTIFIED BY 'Challenge123';" 


CREATE USER 'erp_user'@'localhost' IDENTIFIED BY 'password';


 sudo mysql -e "GRANT ALL PRIVILEGES ON warehouse_oms_v2.* TO 'erp_user2'@'localhost'; FLUSH PRIVILEGES;"