# Copy lên VPS: /etc/nginx/sites-available/warehouse-oms
# Đổi server_name thành domain của bạn rồi: ln -s ... sites-enabled && nginx -t && systemctl reload nginx
server {
    listen 80;
    server_name erp.example.com;

    root /opt/warehouse-oms/dist;
    index index.html;
    client_max_body_size 20m;

    # API -> backend :3000 (frontend gọi /api/... tương đối nên không cần sửa code)
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback cho react-router
    location / {
        try_files $uri $uri/ /index.html;
    }
}
